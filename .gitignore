# Dados brutos e derivados nunca são versionados; apenas metadados e checksums.
data/raw/
data/interim/
data/processed/
data/documents/
!data/metadata/

# Saídas regeneráveis
outputs/figures/
outputs/tables/
outputs/models/
outputs/logs/
outputs/dashboard/
outputs/diagnostics/*.html

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
_targets/
renv/library/
renv/staging/
renv/local/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Quarto
article/manuscript_files/
article/*_cache/
/.quarto/

# LaTeX — auxiliares de compilação (os fontes .tex são versionados)
article/latex/*.aux
article/latex/*.bbl
article/latex/*.blg
article/latex/*.fdb_latexmk
article/latex/*.fls
article/latex/*.log
article/latex/*.out
article/latex/*.toc
article/latex/main.pdf
# figuras/tabelas são cópias geradas pelo pipeline (fonte: outputs/)
article/latex/figures/
article/latex/tables/

# SO / editor
Thumbs.db
.DS_Store
